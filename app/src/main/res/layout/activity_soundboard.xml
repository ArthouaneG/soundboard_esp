                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Navigation (flèches gauche/droite) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <ImageButton
            android:id="@+id/btn_previous_page"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="@android:color/transparent"
            android:contentDescription="Page précédente"
            android:tint="#4ECDC4"/>

        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Page 1"
            android:textColor="#4ECDC4"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="24dp"/>

        <ImageButton
            android:id="@+id/btn_next_page"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@android:drawable/ic_media_next"
            android:background="@android:color/transparent"
            android:contentDescription="Page suivante"
            android:tint="#4ECDC4"/>
    </LinearLayout>

</LinearLayout>
