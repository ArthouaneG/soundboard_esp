<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1A1625">

    <!-- Header: Logo + Bouton Ajout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp">

        <!-- Logo -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/logo_app_kotlin"
            android:contentDescription="@string/logo_description"
            android:scaleType="fitCenter"
            android:tint="#05ab31"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Bouton Ajout (orange) -->
        <Button
            android:id="@+id/btn_add_sound"
            android:layout_width="120dp"
            android:layout_height="56dp"
            android:text="@string/add_sound"
            android:backgroundTint="#FF6B35"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:elevation="4dp"/>
    </LinearLayout>

    <!-- Grille de boutons de sons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Rangée 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_sound_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#4ECDC4"
                android:text=""
                android:contentDescription="@string/sound_button_1"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
            <Button
                android:id="@+id/btn_sound_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#95E1D3"
                android:text=""
                android:contentDescription="@string/sound_button_2"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
            <Button
                android:id="@+id/btn_sound_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#F38181"
                android:text=""
                android:contentDescription="@string/sound_button_3"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Rangée 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_sound_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#AA96DA"
                android:text=""
                android:contentDescription="@string/sound_button_4"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
            <Button
                android:id="@+id/btn_sound_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#FCBAD3"
                android:text=""
                android:contentDescription="@string/sound_button_5"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
            <Button
                android:id="@+id/btn_sound_6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#FFFFD2"
                android:text=""
                android:contentDescription="@string/sound_button_6"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Rangée 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_sound_7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#4ECDC4"
                android:text=""
                android:contentDescription="@string/sound_button"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
            <Button
                android:id="@+id/btn_sound_8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#95E1D3"
                android:text=""
                android:contentDescription="@string/sound_button"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
            <Button
                android:id="@+id/btn_sound_9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#F38181"
                android:text=""
                android:contentDescription="@string/sound_button"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Rangée 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btn_sound_10"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#AA96DA"
                android:text=""
                android:contentDescription="@string/sound_button"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
            <Button
                android:id="@+id/btn_sound_11"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#FCBAD3"
                android:text=""
                android:contentDescription="@string/sound_button"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
            <Button
                android:id="@+id/btn_sound_12"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#FFFFD2"
                android:text=""
                android:contentDescription="@string/sound_button"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Rangée 5 -->
