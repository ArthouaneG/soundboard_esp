<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="0dp"
    android:paddingBottom="8dp"
    android:fitsSystemWindows="true"
    android:background="@color/sonic_bg">

    <!-- Header: Logo + Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp">

        <!-- Logo -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo_app_kotlin"
            android:contentDescription="@string/logo_description"
            android:scaleType="fitCenter"
            android:tint="@color/sonic_cyan"
            android:layout_weight="0"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AUDIO SYSTEM"
            android:textColor="@color/sonic_text_muted"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.15"
            android:layout_marginStart="10dp"/>

        <!-- Bouton Favoris (outline) -->
        <Button
            android:id="@+id/btn_favorites"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="100dp"
            android:layout_height="38dp"
            android:text="FAVORIS"
            android:background="@drawable/btn_header_outline"
            android:textColor="@color/sonic_text_primary"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textAllCaps="false"
            android:elevation="0dp"
            android:layout_marginEnd="8dp"/>

        <!-- Bouton Ajout (filled cyan) -->
        <Button
            android:id="@+id/btn_add_sound"
            style="@style/Widget.AppCompat.Button"
            android:layout_width="100dp"
            android:layout_height="38dp"
            android:text="+ AJOUTER"
            android:background="@drawable/btn_header_filled"
            android:textColor="@color/sonic_bg"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:elevation="0dp"/>
    </LinearLayout>

    <!-- Grille de boutons de sons -->
    <LinearLayout
