                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#4ECDC4"
                android:text=""
                android:contentDescription="@string/sound_button"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
            <Button
                android:id="@+id/btn_sound_14"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#95E1D3"
                android:text=""
                android:contentDescription="@string/sound_button"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
            <Button
                android:id="@+id/btn_sound_15"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#F38181"
                android:text=""
                android:contentDescription="@string/sound_button"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Rangée 6 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_sound_16"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#AA96DA"
                android:text=""
                android:contentDescription="@string/sound_button"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
            <Button
                android:id="@+id/btn_sound_17"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#FCBAD3"
                android:text=""
                android:contentDescription="@string/sound_button"
                android:textColor="#1A1625"
                android:textSize="12sp"
                android:textStyle="bold"
                android:elevation="3dp"
                android:padding="4dp"/>
            <Button
                android:id="@+id/btn_sound_18"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#FFFFD2"
                android:text=""
                android:contentDescription="@string/sound_button"
