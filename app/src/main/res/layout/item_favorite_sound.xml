<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@drawable/fav_item_bg"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Position badge -->
    <TextView
        android:id="@+id/tv_position_number"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:text="01"
        android:textColor="#6B7280"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:background="@drawable/fav_position_circle"
        android:gravity="center"/>

    <!-- Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tv_sound_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/tv_sound_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4B5563"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Play button -->
    <ImageButton
        android:id="@+id/btn_play_favorite"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@android:drawable/ic_media_play"
        android:background="@drawable/fav_play_btn"
        android:contentDescription="Jouer le son"
        android:scaleType="fitCenter"
        android:tint="#0A0E14"
        android:padding="12dp"/>

</LinearLayout>
